  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name:
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<color=#66C5CD>THE EXPEDITION</color>\nExplore, collect supplies and return to the shuttle. Click the\nshuttle console nearby to depart; return through the station portal.\n\n<color=#66C5CD>MOVE & FIGHT</color>\nWASD / Arrows    Move\n1    Toggle combat mode\nLeft click    Attack; hold and release for a charged melee attack\nRight click    Shove; a supported ranged weapon toggles wielding\nE    Use a nearby supply station\n\n<color=#66C5CD>HANDS & STORAGE</color>\nX    Switch active hand\nZ    Wield / unwield a two-handed weapon; otherwise powerup attack\nQ    Drop the active item     Ctrl + Q    Throw towards the pointer\nOutside combat, click a nearby item to pick it up with an empty hand.\nClick a hand slot to move an item or choose that hand.\nClick storage to store a held item; drag stored items to rearrange.\nR while dragging    Rotate     Drag outside storage    Take into hand\n\n<color=#66C5CD>PAUSE & HELP</color>\nEsc    Pause / resume; close the topmost dialog first\nInstructions, Pause and Quit are always available during play.\nOpening instructions pauses the expedition. Closing them restores\nits previous state.\n\nScroll to read more. Use arrows or Tab to select; Enter to activate."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 433b5844351e4e15918c223382a93237, type: 2}
  m_sharedMaterial: {fileID: 5330573177359655704, guid: 433b5844351e4e15918c223382a93237, type: 2}
